# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Settings (Optional - if blank, system runs fully offline on local SQLite)
SUPABASE_URL=
SUPABASE_KEY=

# ChromaDB Vector Storage Settings (Optional - system falls back to ./chroma_db)
CHROMA_DB_PATH=./chroma_db

# Server Configuration
PORT=8000
HOST=127.0.0.1
